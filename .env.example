# Copy to .env (git-ignored) and fill in. Never commit .env.

# "live" talks to Zerodha Kite Connect; "mock" uses generated data and needs no account.
KITE_MODE=live

# From https://developers.kite.trade/apps — the app needs the paid Connect plan for market data.
KITE_API_KEY=
KITE_API_SECRET=

# Must match the "Redirect URL" registered for the app in the Kite developer console exactly.
KITE_REDIRECT_URL=http://127.0.0.1:8787/api/auth/callback

# Server bind address. Keep it on localhost: Zerodha's terms forbid redistributing market data.
HOST=127.0.0.1
PORT=8787

# Optional:
# APP_URL=http://127.0.0.1:8787   # where the browser lands after login (pnpm dev uses the Vite server)
# DATA_DIR=./data                 # SQLite database: session, instruments, candle cache
# LOG_LEVEL=info
# KITE_HISTORY_MAX_DAYS=minute=60,3minute=100,5minute=100,10minute=100,15minute=200,30minute=200,60minute=400,day=2000
#                                 # max days per historical request (undocumented by Kite; adapts if Kite rejects a range)
# MOCK_LATENCY_MS=150             # mock mode: simulated latency of each Kite request
# MOCK_MARKET_OPEN=1              # mock mode: start as if the market is open (last trading day, 11:00 IST)
# MOCK_START=2026-10-09 09:13     # mock mode: start the market clock at this IST time
# MOCK_SPEED=10                   # mock/replay: run the market clock faster
# TICKS_RECORD=1                  # live mode: record raw ticks to data/recordings/ (git-ignored)
# TICKS_REPLAY=data/recordings/ticks-2026-10-12.jsonl   # live mode: replay a recording instead of Kite's feed
# REPLAY_SPEED=1
