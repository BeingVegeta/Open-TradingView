{
  "name": "open-tradingview",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "concurrently -k -n server,web -c blue,magenta \"pnpm --filter @otv/server dev\" \"pnpm --filter @otv/web dev\"",
    "dev:mock": "cross-env KITE_MODE=mock pnpm dev",
    "build": "pnpm --filter @otv/web build",
    "start": "pnpm build && pnpm --filter @otv/server start",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm test",
    "b2b:compare": "tsx apps/server/scripts/b2bCompare.ts",
    "b2b:pine-diff": "tsx apps/server/scripts/b2bPineDiff.ts",
    "b2b:backtest": "tsx apps/server/scripts/b2bBacktest.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "concurrently": "^10.0.6",
    "cross-env": "^10.1.0",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3"
  }
}
